# Copy to .env.local for local dev. On Vercel set these in Project > Settings > Environment Variables.
# Use long random values in production (e.g. `openssl rand -base64 32`).

SESSION_SECRET=change-me-long-random
LETTER_SECRET=change-me-another-long-random   # encrypts letters at rest. If you lose it, letters are unreadable.
HERO_CODE=the-passcode-you-give-the-birthday-person
ADMIN_CODE=your-private-organiser-code

# Optional: nobody (not even with the passcode) can enter before this moment. ISO format.
# UNLOCK_AT=2027-01-15T00:00:00+05:00

# Storage in production: add the Upstash Redis integration from the Vercel Marketplace.
# It injects KV_REST_API_URL / KV_REST_API_TOKEN (or UPSTASH_REDIS_REST_URL / _TOKEN) automatically.
# Locally, with none of these set, a JSON file in .data/ is used instead.
